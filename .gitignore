.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Behavioural eval run outputs. Build artefacts of a run, never part of the
# distributable skill.
evals/runs/

# Harness-local state. The package itself is harness-agnostic; anything a
# particular agent host writes beside it stays out of the distributable folder.
.claude/
.codex/
.agents/

# Session handoff notes. Working state for whoever picks the package up next;
# not part of the distributable skill, so it must never become tracked.
.handoff/

config/
*.local.json
ITR_*.md
Accountant_*.md
Missing_Info_And_Questions.md
*.pdf
*.csv
*.tsv
*.xls
*.xlsx
*.doc
*.docx
